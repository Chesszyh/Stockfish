{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Stockfish",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/dev-debug/stockfish",
      "args": [],
      "cwd": "${workspaceFolder}/src",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "cmake-build-debug",
      "setupCommands": [
        {
          "description": "Enable GDB pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
